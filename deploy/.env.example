# ==============================================================================
# Batam MedHub — Production Deployment Environment
# Copy this file to `.env` and fill in real values before starting the stack.
#   cp .env.example .env && nano .env
# All values marked "CHANGE ME" should be replaced with strong random secrets.
# Generate one with:  openssl rand -hex 24
# ==============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (superuser + per-provider least-privilege databases)
# -----------------------------------------------------------------------------
PROVIDER_POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password

HOSPITAL_DB_PASSWORD=CHANGE_ME_hospital_db_password
FERRY_DB_PASSWORD=CHANGE_ME_ferry_db_password
HOTEL_DB_PASSWORD=CHANGE_ME_hotel_db_password
TRANSPORT_DB_PASSWORD=CHANGE_ME_transport_db_password

# -----------------------------------------------------------------------------
# Provider integration keys (X-Integration-Key). MUST match the values the
# backend uses (they are shared secrets between core and each provider).
# -----------------------------------------------------------------------------
HOSPITAL_INTEGRATION_KEY=CHANGE_ME_hospital_integration_key
FERRY_INTEGRATION_KEY=CHANGE_ME_ferry_integration_key
HOTEL_INTEGRATION_KEY=CHANGE_ME_hotel_integration_key
TRANSPORT_INTEGRATION_KEY=CHANGE_ME_transport_integration_key

# -----------------------------------------------------------------------------
# Backend JWT signing secret (must be at least 32 bytes/characters)
# -----------------------------------------------------------------------------
JWT_SIGNING_SECRET=CHANGE_ME_jwt_signing_secret_at_least_32_chars_long

# -----------------------------------------------------------------------------
# Backend demo reset secret (authenticates POST /v1/demo/reset)
# -----------------------------------------------------------------------------
DEMO_SECRET=CHANGE_ME_demo_reset_secret

# -----------------------------------------------------------------------------
# Cloudflare Workers AI (LLM intent extraction)
#   - CLOUDFLARE_ACCOUNT_ID : your Cloudflare account ID
#   - CLOUDFLARE_API_TOKEN  : a Workers AI API token (bearer)
#   - CLOUDFLARE_AI_BASE_URL: OpenAI-compatible gateway URL. The backend auto-
#     detects the "/ai/v1" suffix and uses /chat/completions.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_cloudflare_account_id
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_api_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/CHANGE_ME_cloudflare_account_id/ai/v1
