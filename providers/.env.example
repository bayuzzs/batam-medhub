# Batam MedHub Provider Platform Environment Configuration Example
# Synthetic hackathon configuration only. Do not use real production secrets.

# ==============================================================================
# PostgreSQL Administrator Configuration
# ==============================================================================
PROVIDER_POSTGRES_PASSWORD=provider_admin_dev_password

# ==============================================================================
# Database User Passwords (Least Privilege)
# ==============================================================================
HOSPITAL_DB_PASSWORD=hospital_dev_password
FERRY_DB_PASSWORD=ferry_dev_password
HOTEL_DB_PASSWORD=hotel_dev_password
TRANSPORT_DB_PASSWORD=transport_dev_password

# ==============================================================================
# Provider Integration Secrets (X-Integration-Key Header)
# ==============================================================================
HOSPITAL_INTEGRATION_KEY=hospital_dev_secret
FERRY_INTEGRATION_KEY=ferry_dev_secret
HOTEL_INTEGRATION_KEY=hotel_dev_secret
TRANSPORT_INTEGRATION_KEY=transport_dev_secret

# ==============================================================================
# Service Ports (Internal / External Mapping)
# ==============================================================================
# Hospital:   http://localhost:8081 (Container port 8080)
# Ferry:      http://localhost:8082 (Container port 8080)
# Hotel:      http://localhost:8083 (Container port 8080)
# Transport:  http://localhost:8084 (Container port 8080)
# PostgreSQL: localhost:5432
