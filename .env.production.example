# ==============================================================================
# Batam MedHub — Production Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env.production di VPS:
# cp .env.production.example .env.production

# ------------------------------------------------------------------------------
# 1. Domain & SSL (Caddy Reverse Proxy)
# ------------------------------------------------------------------------------
# Masukkan domain/subdomain yang sudah diarahkan (A record) ke IP VPS.
# Contoh: api.batammedhub.com
DOMAIN=api.example.com

# ------------------------------------------------------------------------------
# 2. Database Passwords (PostgreSQL)
# ------------------------------------------------------------------------------
# Gunakan password acak yang kuat (misal hasil dari: openssl rand -base64 24)
POSTGRES_USER=provider_admin
POSTGRES_PASSWORD=GANTI_DENGAN_POSTGRES_ADMIN_PASSWORD_KUAT
CORE_DB_PASSWORD=GANTI_DENGAN_CORE_DB_PASSWORD_KUAT
HOSPITAL_DB_PASSWORD=GANTI_DENGAN_HOSPITAL_DB_PASSWORD_KUAT
FERRY_DB_PASSWORD=GANTI_DENGAN_FERRY_DB_PASSWORD_KUAT
HOTEL_DB_PASSWORD=GANTI_DENGAN_HOTEL_DB_PASSWORD_KUAT
TRANSPORT_DB_PASSWORD=GANTI_DENGAN_TRANSPORT_DB_PASSWORD_KUAT

# ------------------------------------------------------------------------------
# 3. JWT & Security (Core Backend)
# ------------------------------------------------------------------------------
# Minimal 32 karakter acak (misal: openssl rand -hex 32)
JWT_SIGNING_SECRET=GANTI_DENGAN_JWT_SECRET_MINIMAL_32_KARAKTER_ACAK
JWT_ISSUER=batam-medhub
JWT_AUDIENCE=batam-medhub-mobile

# Secret untuk memproteksi endpoint POST /v1/demo/reset
DEMO_SECRET=GANTI_DENGAN_DEMO_RESET_SECRET_KUAT

# ------------------------------------------------------------------------------
# 4. Provider Integration Keys (Shared Secret antar Backend & Mock Provider)
# ------------------------------------------------------------------------------
HOSPITAL_INTEGRATION_KEY=GANTI_DENGAN_HOSPITAL_SECRET_KUAT
FERRY_INTEGRATION_KEY=GANTI_DENGAN_FERRY_SECRET_KUAT
HOTEL_INTEGRATION_KEY=GANTI_DENGAN_HOTEL_SECRET_KUAT
TRANSPORT_INTEGRATION_KEY=GANTI_DENGAN_TRANSPORT_SECRET_KUAT

PROVIDER_HTTP_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 5. Cloudflare Workers AI Intent Extractor (Opsional)
# ------------------------------------------------------------------------------
# Jika dikosongkan, backend otomatis beralih ke rule-based intent extractor.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_TIMEOUT_SECONDS=15
